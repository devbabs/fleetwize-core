        $vehicle = Vehicle::factory()->for($user)->create();
        $vehicle->trips()->create(['distance_km' => 10, 'max_engine_rpm' => 3200, 'start_time' => now()]);
        $vehicle->faults()->create(['obd_code' => 'P0300', 'meaning' => 'Random misfire', 'severity' => 3]);
