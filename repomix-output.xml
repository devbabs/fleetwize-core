type StaffRow = {
    id: number;
    name: string;
    email: string;
    role: string;
};

export default function CompanySettings({ companyProfile, staff }: { companyProfile: CompanyProfile; staff: StaffRow[] }) {
    const { data, setData, patch, processing, errors } = useForm({
