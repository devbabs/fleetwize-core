        $customers = $agent->onboardedUsers()
            ->with(['vehicles' => fn ($query) => $query->where('agent_id', $agent->id)])
            ->withCount('vehicles')
            ->latest()
            ->paginate(15)
            ->withQueryString()
            ->through($this->mapCustomer(...));

        return Inertia::render('agent/customers/index', [
            'customers' => $customers,
        ]);
